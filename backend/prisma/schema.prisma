generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Trip {
  id        Int      @id @default(autoincrement())
  name      String
  startDate DateTime
  endDate   DateTime
  places    Place[]
}

model Place {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  status      PlaceStatus @default(DA_VEDERE)
  tripId      Int
  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

enum PlaceStatus {
  DA_VEDERE
  VISITATO
}